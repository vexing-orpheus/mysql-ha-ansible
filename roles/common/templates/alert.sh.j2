#!/usr/bin/env bash
# Shared alert notifier — managed by Ansible (role: common)
# Usage: alert.sh "<message>"
#
# Deployed to every cluster node (unlike roles/xtrabackup/templates/alert.sh.j2,
# which is backup-cron-specific and only lives on the active backup node) —
# this one is called by service-down-alert.sh.j2, which backs the systemd
# ExecStopPost hooks on mysql.service/xinetd.service (db_nodes) and
# haproxy.service/keepalived.service (proxy_nodes), so a stop or crash of any
# of those gets alerted from wherever it happened, not just from the backup
# node.
#
# POSTs a JSON payload to an incoming webhook. alert_webhook_format (group_vars)
# picks the shape: "simple" is a flat {key: message} object — Slack expects
# the message under "text", Discord under "content", set via
# alert_webhook_payload_key. "teams" posts a MessageCard object instead, the
# shape Microsoft Teams / a Power Automate HTTP-trigger-to-Teams flow expects.
set -uo pipefail

MESSAGE="${1:?usage: alert.sh <message>}"
HOST=$(hostname -s)
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
FULL_MESSAGE="[${TIMESTAMP}] ${HOST}: ${MESSAGE}"

logger -t mysql-ha-alert "${FULL_MESSAGE}"

{% if alert_webhook_format == 'teams' %}
PAYLOAD=$(jq -n --arg host "${HOST}" --arg msg "${FULL_MESSAGE}" '
    {"@type": "MessageCard", "@context": "https://schema.org/extensions",
     "summary": ("mysql-ha-cluster alert: " + $host),
     "themeColor": "FF0000",
     "title": ("mysql-ha-cluster alert: " + $host),
     "text": $msg}')
{% else %}
PAYLOAD=$(jq -n --arg key "{{ alert_webhook_payload_key }}" --arg msg "${FULL_MESSAGE}" '{($key): $msg}')
{% endif %}

curl -fsS -X POST -H 'Content-Type: application/json' -d "${PAYLOAD}" "{{ alert_webhook_url }}" >/dev/null \
    || logger -t mysql-ha-alert "WARNING: failed to deliver alert webhook"
