# Managed by Ansible (role: common) — do not edit by hand

# ── Virtual memory ──────────────────────────────────────────────────────────
vm.swappiness = {{ vm_swappiness }}
vm.overcommit_memory = {{ vm_overcommit_memory }}
vm.overcommit_ratio = {{ vm_overcommit_ratio }}

# ── Huge pages ────────────────────────────────────────────────────────────
# Calculated by the postgresql_patroni role once shared_buffers is known;
# left at 0 here so common can run standalone/idempotently before that role.
vm.nr_hugepages = {{ hugepages_count | default(0) }}

# ── Shared memory ────────────────────────────────────────────────────────
kernel.shmmax = {{ kernel_shmmax }}
kernel.shmall = {{ kernel_shmall }}

# ── Network buffers ─────────────────────────────────────────────────────
net.core.somaxconn = 65535
net.core.netdev_max_backlog = 65536
net.ipv4.tcp_max_syn_backlog = 65536
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216

# ── TCP keepalive ────────────────────────────────────────────────────────
net.ipv4.tcp_keepalive_time = 60
net.ipv4.tcp_keepalive_intvl = 10
net.ipv4.tcp_keepalive_probes = 6

# ── File handles ─────────────────────────────────────────────────────────
fs.file-max = {{ fs_file_max }}

# ── NUMA ─────────────────────────────────────────────────────────────────
kernel.numa_balancing = 1

# ── Keepalived/HAProxy (proxy nodes only, harmless elsewhere) ─────────────
net.ipv4.ip_nonlocal_bind = 1
net.ipv4.ip_forward = 1
net.netfilter.nf_conntrack_max = 131072
