# =============================================================================
# HAProxy configuration — managed by Ansible (role: haproxy_keepalived)
# Node: {{ inventory_hostname }}
# =============================================================================

global
    maxconn             8192
    log                 127.0.0.1 local0
    log                 127.0.0.1 local1 notice
    chroot              /var/lib/haproxy
    stats               socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats               timeout 30s
    user                haproxy
    group               haproxy
    daemon
    nbthread            {{ ansible_processor_vcpus | default(ansible_processor_count) }}

defaults
    log                 global
    mode                tcp
    option              tcplog
    option              dontlognull
    retries             3
    option              redispatch
    timeout connect     5s
    timeout client      30m
    timeout server      30m
    timeout check       5s

listen stats
    bind                *:{{ haproxy_stats_port }}
    mode                http
    stats               enable
    stats               uri /stats
    stats               realm HAProxy\ Statistics
    stats               auth {{ haproxy_stats_user }}:{{ haproxy_stats_pass }}
    stats               refresh 5s
    stats               show-node
    stats               show-legends
    stats               admin if TRUE

listen postgresql_primary
    bind                *:{{ haproxy_write_port }}
    mode                tcp
    option              tcplog
    option              httpchk GET /master
    http-check          expect status 200
    default-server      inter 3s fastinter 1s downinter 5s rise 2 fall 3 on-marked-down shutdown-sessions
    balance             first
{% for host in groups['db_nodes'] %}
    server  {{ host }}  {{ hostvars[host].ansible_host }}:{{ pg_port }}  check port {{ patroni_api_port }}
{% endfor %}

listen postgresql_replicas
    bind                *:{{ haproxy_read_port }}
    mode                tcp
    option              tcplog
    option              httpchk GET /replica
    http-check          expect status 200
    default-server      inter 3s fastinter 1s downinter 5s rise 2 fall 3 on-marked-down shutdown-sessions
    balance             roundrobin
{% for host in groups['db_nodes'] %}
    server  {{ host }}  {{ hostvars[host].ansible_host }}:{{ pg_port }}  check port {{ patroni_api_port }}
{% endfor %}
