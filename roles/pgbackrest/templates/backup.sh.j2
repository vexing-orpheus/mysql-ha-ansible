#!/usr/bin/env bash
# pgBackRest backup wrapper — managed by Ansible (role: pgbackrest)
# Usage: backup.sh <full|diff>
#
# Only runs when this node is currently the Patroni primary, so cron can be
# deployed identically to all 3 DB nodes without chasing the floating leader.
set -uo pipefail

BACKUP_TYPE="${1:?usage: backup.sh <full|diff>}"
ALERT="{{ pgbackrest_scripts_dir }}/alert.sh"
STANZA="{{ patroni_scope }}"

ROLE=$(curl -fsS "http://127.0.0.1:{{ patroni_api_port }}/patroni" 2>/dev/null | jq -r '.role // empty')

if [[ "${ROLE}" != "master" && "${ROLE}" != "primary" ]]; then
    exit 0
fi

if ! pgbackrest --stanza="${STANZA}" --type="${BACKUP_TYPE}" backup; then
    "${ALERT}" "pgBackRest ${BACKUP_TYPE} backup FAILED for stanza ${STANZA}"
    exit 1
fi
