#!/usr/bin/env bash
# pgBackRest integrity check wrapper — managed by Ansible (role: pgbackrest)
#
# Validates WAL continuity and backup manifest checksums (no restore).
# Only runs on the current Patroni primary — see backup.sh.j2 for why.
set -uo pipefail

ALERT="{{ pgbackrest_scripts_dir }}/alert.sh"
STANZA="{{ patroni_scope }}"

ROLE=$(curl -fsS "http://127.0.0.1:{{ patroni_api_port }}/patroni" 2>/dev/null | jq -r '.role // empty')

if [[ "${ROLE}" != "master" && "${ROLE}" != "primary" ]]; then
    exit 0
fi

if ! pgbackrest --stanza="${STANZA}" check; then
    "${ALERT}" "pgBackRest check FAILED for stanza ${STANZA} — WAL archiving or backup integrity issue"
    exit 1
fi
