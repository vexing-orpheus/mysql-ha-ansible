# =============================================================================
# Galera / Percona XtraDB Cluster configuration — managed by Ansible
# (role: mysql_galera)
# Node: {{ inventory_hostname }}
# RAM: {{ ansible_memtotal_mb // 1024 }} GB  ->  innodb_buffer_pool_size={{ innodb_buffer_pool_size }},
#                                        max_connections={{ mysql_max_connections_final }} (ceiling={{ mysql_max_connections }})
# =============================================================================

[mysqld]
bind-address                    = 0.0.0.0
port                             = {{ mysql_port }}
datadir                          = {{ mysql_data_dir }}
socket                           = {{ mysql_socket }}
pid-file                         = /var/run/mysqld/mysqld.pid

default_storage_engine           = InnoDB
max_connections                   = {{ mysql_max_connections_final }}

# ── InnoDB ──────────────────────────────────────────────────────────────
innodb_buffer_pool_size          = {{ innodb_buffer_pool_size }}
innodb_buffer_pool_instances     = {{ innodb_buffer_pool_instances }}
innodb_log_file_size              = 1G
innodb_flush_log_at_trx_commit    = 2
innodb_flush_method                = O_DIRECT
innodb_file_per_table               = 1
innodb_autoinc_lock_mode             = 2
innodb_doublewrite                    = 1

# ── Binary log (point-in-time recovery alongside xtrabackup) ────────────
log_bin                           = {{ mysql_log_dir }}/mysql-bin
log_bin_index                      = {{ mysql_log_dir }}/mysql-bin.index
binlog_format                       = ROW
binlog_expire_logs_seconds           = 604800
sync_binlog                           = 1

# ── Logging ─────────────────────────────────────────────────────────────
log_error                         = {{ mysql_log_dir }}/error.log
slow_query_log                     = 1
slow_query_log_file                 = {{ mysql_log_dir }}/slow.log
long_query_time                      = 1

# ── Galera / wsrep ──────────────────────────────────────────────────────
# pxc_encrypt_cluster_traffic defaults to ON in PXC 8.0: it auto-manages
# encryption for BOTH gcomm replication and SST, generating/using each node's
# own self-signed cert. Those certs aren't mutually trusted across nodes (no
# shared CA), so encrypted gcomm fails with "certificate signature failure"
# and SST fails with "certificate verify failed" / "no peer connection" —
# and it overrides manual per-channel settings (wsrep_provider_options
# socket.ssl, [sst] encrypt) at connection time regardless of what's written
# for them below, so those alone are not enough; this is the actual master
# switch. DB nodes are assumed to share a trusted private subnet;
# client-to-mysqld TLS is unaffected by this.
pxc_encrypt_cluster_traffic          = OFF

wsrep_on                          = ON
wsrep_provider                      = {{ wsrep_provider_path }}
wsrep_cluster_name                   = {{ galera_cluster_name }}
wsrep_cluster_address = gcomm://{% for host in groups['db_nodes'] %}{{ hostvars[host].ansible_host }}{% if not loop.last %},{% endif %}{% endfor %}

wsrep_node_name                   = {{ inventory_hostname }}
wsrep_node_address                 = {{ ansible_host }}

wsrep_provider_options = "gcache.size={{ galera_gcache_size_mb }}M; gcs.fc_limit=128; socket.ssl=NO"
wsrep_slave_threads                  = {{ ansible_processor_vcpus | default(ansible_processor_count) }}

wsrep_sst_method                   = xtrabackup-v2

pxc_strict_mode                      = ENFORCING

[sst]
encrypt = 0
