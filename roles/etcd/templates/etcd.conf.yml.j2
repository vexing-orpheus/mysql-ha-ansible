# =============================================================================
# etcd configuration — managed by Ansible (role: etcd)
# Node: {{ inventory_hostname }}
# =============================================================================

name: '{{ etcd_cluster_name }}-{{ inventory_hostname }}'
data-dir: '{{ etcd_data_dir }}'

listen-peer-urls: 'http://{{ ansible_host }}:{{ etcd_peer_port }}'
initial-advertise-peer-urls: 'http://{{ ansible_host }}:{{ etcd_peer_port }}'

listen-client-urls: 'http://{{ ansible_host }}:{{ etcd_client_port }},http://127.0.0.1:{{ etcd_client_port }}'
advertise-client-urls: 'http://{{ ansible_host }}:{{ etcd_client_port }}'

initial-cluster: '{% for host in groups["db_nodes"] %}{{ etcd_cluster_name }}-{{ host }}=http://{{ hostvars[host].ansible_host }}:{{ etcd_peer_port }}{% if not loop.last %},{% endif %}{% endfor %}'
initial-cluster-token: '{{ etcd_cluster_name }}-token'
initial-cluster-state: 'new'

auto-compaction-mode: periodic
auto-compaction-retention: '1h'
snapshot-count: 10000

heartbeat-interval: 100
election-timeout: 1000

quota-backend-bytes: 2147483648

log-level: 'warn'
log-outputs: ['stderr']
listen-metrics-urls: 'http://127.0.0.1:2381'

strict-reconfig-check: true
enable-v2: false
