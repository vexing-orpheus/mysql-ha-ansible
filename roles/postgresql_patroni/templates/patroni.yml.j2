# =============================================================================
# Patroni configuration — managed by Ansible (role: postgresql_patroni)
# Node: {{ inventory_hostname }}
# RAM: {{ ansible_memtotal_mb // 1024 }} GB  ->  shared_buffers={{ shared_buffers }}
# =============================================================================

scope: {{ patroni_scope }}
namespace: /service/
name: {{ inventory_hostname }}

etcd3:
  hosts: {% for host in groups['db_nodes'] %}{{ hostvars[host].ansible_host }}:{{ etcd_client_port }}{% if not loop.last %},{% endif %}{% endfor %}

  protocol: http

restapi:
  listen: 0.0.0.0:{{ patroni_api_port }}
  connect_address: {{ ansible_host }}:{{ patroni_api_port }}

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576

    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        wal_level: replica
        hot_standby: "on"
        max_wal_senders: 10
        max_replication_slots: 10
        wal_keep_size: 1024
        hot_standby_feedback: "on"

        max_connections: 200

        shared_buffers: '{{ shared_buffers }}'
        effective_cache_size: '{{ effective_cache_size }}'
        work_mem: '{{ work_mem }}'
        maintenance_work_mem: '{{ maintenance_work_mem }}'
        wal_buffers: '64MB'

        huge_pages: 'try'

        max_parallel_workers_per_gather: 2
        max_parallel_workers: 4
        max_parallel_maintenance_workers: 2

        checkpoint_completion_target: 0.9
        min_wal_size: '512MB'
        max_wal_size: '4GB'
        synchronous_commit: 'on'

        random_page_cost: '{{ random_page_cost }}'
        effective_io_concurrency: {{ effective_io_concurrency }}

        log_destination: 'stderr'
        logging_collector: 'on'
        log_directory: '{{ pg_log_dir }}'
        log_filename: 'postgresql-%Y-%m-%d_%H%M%S.log'
        log_rotation_age: '1d'
        log_rotation_size: '100MB'
        log_min_duration_statement: 1000
        log_checkpoints: 'on'
        log_connections: 'on'
        log_disconnections: 'on'
        log_lock_waits: 'on'
        log_temp_files: 0
        log_autovacuum_min_duration: 0
        log_line_prefix: '%t [%p]: [%l-1] user=%u,db=%d,app=%a,client=%h '

        autovacuum: 'on'
        autovacuum_max_workers: 3
        autovacuum_naptime: '30s'

        password_encryption: scram-sha-256
        ssl: 'off'

  users:
    {{ patroni_super_user }}:
      password: '{{ patroni_super_pass }}'
      options:
        - createrole
        - createdb
    {{ repl_user }}:
      password: '{{ repl_password }}'
      options:
        - replication
    {{ patroni_rewind_user }}:
      password: '{{ patroni_rewind_pass }}'
    {{ health_user }}:
      password: '{{ health_pass }}'

  pg_hba:
    - local   all             postgres                                peer
    - local   all             all                                     scram-sha-256
{% for host in groups['db_nodes'] %}
    - host    replication     {{ repl_user }}    {{ hostvars[host].ansible_host }}/32       scram-sha-256
{% endfor %}
{% for host in groups['db_nodes'] %}
    - host    all             {{ patroni_rewind_user }}  {{ hostvars[host].ansible_host }}/32  scram-sha-256
{% endfor %}
{% for host in groups['proxy_nodes'] %}
    - host    all             all             {{ hostvars[host].ansible_host }}/32    scram-sha-256
    - host    all             {{ health_user }}  {{ hostvars[host].ansible_host }}/32    scram-sha-256
{% endfor %}
    - host    all             all             {{ app_network }}         scram-sha-256

postgresql:
  listen: 0.0.0.0:{{ pg_port }}
  connect_address: {{ ansible_host }}:{{ pg_port }}
  data_dir: {{ pg_data_dir }}
  bin_dir: /usr/lib/postgresql/{{ pg_version }}/bin
  pgpass: /var/lib/postgresql/.pgpass

  authentication:
    replication:
      username: {{ repl_user }}
      password: '{{ repl_password }}'
    superuser:
      username: {{ patroni_super_user }}
      password: '{{ patroni_super_pass }}'
    rewind:
      username: {{ patroni_rewind_user }}
      password: '{{ patroni_rewind_pass }}'

  parameters:
    unix_socket_directories: '/var/run/postgresql'

  create_replica_methods:
    - basebackup
  basebackup:
    checkpoint: 'fast'
    max-rate: '300M'
    wal-method: stream

  pg_rewind:
    username: {{ patroni_rewind_user }}
    password: '{{ patroni_rewind_pass }}'

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false
