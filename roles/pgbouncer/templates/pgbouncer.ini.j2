; =============================================================================
; PgBouncer configuration — managed by Ansible (role: pgbouncer)
; Node: {{ inventory_hostname }}  (peer_id={{ pgbouncer_peer_id }})
; PgBouncer version: {{ pgbouncer_version }}
; =============================================================================

[databases]
{{ app_db }} = host=127.0.0.1 port={{ haproxy_write_port }} \
    dbname={{ app_db }} \
    pool_size={{ pgbouncer_default_pool_size }}

{{ app_db }}_read = host=127.0.0.1 port={{ haproxy_read_port }} \
    dbname={{ app_db }} \
    pool_size={{ pgbouncer_default_pool_size }}

postgres = host=127.0.0.1 port={{ haproxy_write_port }} \
    dbname=postgres \
    pool_size=5

[pgbouncer]
listen_addr = *
listen_port = {{ pgbouncer_port }}
unix_socket_dir = {{ pgbouncer_run_dir }}

auth_type = hba
auth_file = {{ pgbouncer_conf_dir }}/userlist.txt
auth_hba_file = {{ pgbouncer_conf_dir }}/pool_hba.conf

pool_mode = {{ pgbouncer_pool_mode }}

max_client_conn = {{ pgbouncer_max_client_conn }}
default_pool_size = {{ pgbouncer_default_pool_size }}
min_pool_size = {{ pgbouncer_min_pool_size }}
reserve_pool_size = {{ pgbouncer_reserve_pool_size }}
reserve_pool_timeout = 5

server_idle_timeout = {{ pgbouncer_server_idle_timeout }}
client_idle_timeout = {{ pgbouncer_client_idle_timeout }}
server_lifetime = 3600
query_wait_timeout = 120
client_login_timeout = 60

server_reset_query = DISCARD ALL
server_reset_query_always = 0

logfile = {{ pgbouncer_log_dir }}/pgbouncer.log
pidfile = {{ pgbouncer_run_dir }}/pgbouncer.pid

log_connections = 1
log_disconnections = 1
log_pooler_errors = 1
log_stats = 1
stats_period = 60
verbose = 0

admin_users = {{ pcp_user }}, {{ patroni_super_user }}
stats_users = {{ pcp_user }}, {{ patroni_super_user }}

so_reuseport = 1
dns_max_ttl = 15
dns_nxdomain_ttl = 15
server_check_query = SELECT 1
server_check_delay = 30
{% if enable_peer_sync %}

; ── Peer synchronisation (PgBouncer {{ pgbouncer_min_peer_version }}+) ──────
peer_id = {{ pgbouncer_peer_id }}

[peers]
{% for host in groups['proxy_nodes'] %}
{{ loop.index }} = host={{ hostvars[host].ansible_host }}, port={{ pgbouncer_port }}
{% endfor %}
{% endif %}
